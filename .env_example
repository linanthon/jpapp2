# DB
DB_USER=postgres
DB_PASS=password
DB_HOST=postgres    # 'localhost' for dev at local
DB_PORT=5432        # default port

# Auth
SECRET_KEY=your-secret-key-for-jwt-encode-decode

# Redis
REDIS_URL=redis://redis:6379/0  # 'redis://localhost:6379/0' for dev at local

# TTS (OpenJTalk JP + eSpeak NG EN)
TTS_ENABLED=true
TTS_DEFAULT_JP_ENGINE=openjtalk
TTS_DEFAULT_EN_ENGINE=espeak

# Use command names if binaries are in PATH, or absolute .exe paths on Windows.
# OPENJTALK_BIN=open_jtalk
# ESPEAK_BIN=espeak-ng
OPENJTALK_BIN=
ESPEAK_BIN=

# Required for OpenJTalk
# Example (adjust to your actual install location):
# OPENJTALK_DIC_PATH=C:\\open_jtalk\\dic
# OPENJTALK_VOICE_PATH=C:\\open_jtalk\\voice\\mei_normal.htsvoice
OPENJTALK_DIC_PATH=
OPENJTALK_VOICE_PATH=

# eSpeak voice id (single voice only)
ESPEAK_EN_VOICE=en-us

TTS_TIMEOUT_MS=2000
TTS_MAX_TEXT_LEN=500
